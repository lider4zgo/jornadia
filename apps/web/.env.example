# Copia este archivo como .env.local y llena los valores de tu proyecto "jornadia"
# (Supabase → Project Settings → API). La llave "anon" es pública por diseño;
# la seguridad la dan las políticas RLS. NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon
# Número de WhatsApp de soporte (formato internacional, sin + ni espacios)
VITE_SUPPORT_WHATSAPP=5218711234567
